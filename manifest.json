{
  "id": "event-rsvps",
  "name": "Event RSVPs",
  "version": "1.2.0",
  "description": "Create org events and collect RSVPs — who's coming, headcount for catering, send reminders to non-responders, export attendee lists. An event can be shared by link so people outside the household can RSVP without an account.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["events", "rsvp", "attendance", "everyone"],
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "automation_actions": {
    "create_event": {
      "title": "Open an RSVP sheet",
      "description": "Create an event and start collecting RSVPs when another app's event fires - a meeting scheduled, a potluck planned, a workday called.",
      "params": {
        "created_by": {
          "type": "member",
          "label": "Organiser",
          "required": true
        },
        "title": {
          "type": "text",
          "label": "Event title",
          "required": true
        },
        "event_date": {
          "type": "text",
          "label": "Date (YYYY-MM-DD, usually mapped from the triggering event)",
          "required": true
        },
        "location": {
          "type": "text",
          "label": "Where",
          "default": ""
        }
      },
      "dedupe": {
        "table": "events",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "events",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "event_date": ":event_date",
            "location": ":location",
            "created_by": ":created_by",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "row_policies": {
    "events": {
      "kind": "adult_writable",
      "steward_writes_only": true,
      "retain_days": {
        "default": 730,
        "timestamp_column": "event_date",
        "override_key": "event_history",
        "dependent_tables": [
          { "table": "rsvps", "foreign_key": "event_id" },
          { "table": "guest_rsvps", "foreign_key": "event_id" }
        ]
      }
    },
    "rsvps": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_owner_only": true,
      "max_per_member": {
        "member_column": "member_id",
        "scope_columns": ["event_id"],
        "limit": 1
      }
    },
    "activity": {
      "kind": "owner_only",
      "member_column": "actor_id",
      "adults_bypass": true,
      "retain_days": { "default": 365, "timestamp_column": "created_at", "override_key": "activity_history" }
    },
    "guest_rsvps": {
      "kind": "adult_writable",
      "steward_writes_only": true,
      "steward_reads_only": true,
      "audit_writes": true,
      "max_rows": 200
    }
  },
  "member_references": {
    "events": { "column": "created_by", "on_removed": "keep" },
    "rsvps": { "column": "member_id", "on_removed": "delete" },
    "activity": { "column": "actor_id", "on_removed": "keep" }
  },
  "db_plaintext_columns": ["cancelled", "guest_count", "guest_name", "source"],
  "shareable": {
    "event": {
      "table": "events",
      "title_column": "title",
      "columns": [
        { "column": "description", "label": "Details", "format": "multiline" },
        { "column": "location", "label": "Location" },
        { "column": "event_date", "label": "When", "format": "datetime" },
        { "column": "rsvp_deadline", "label": "RSVP by", "format": "datetime" }
      ],
      "visible_where": { "column": "cancelled", "values": ["0"] },
      "aggregates": [
        {
          "label": "Going",
          "table": "rsvps",
          "fk_column": "event_id",
          "op": "count",
          "where_column": "status",
          "where_values": ["yes"]
        },
        {
          "label": "Extra guests",
          "table": "rsvps",
          "fk_column": "event_id",
          "op": "sum",
          "value_column": "guest_count",
          "where_column": "status",
          "where_values": ["yes"]
        },
        {
          "label": "Guest RSVPs",
          "table": "guest_rsvps",
          "fk_column": "event_id",
          "op": "sum",
          "value_column": "guest_count",
          "where_column": "status",
          "where_values": ["going"]
        }
      ],
      "submit": {
        "table": "guest_rsvps",
        "fk_column": "event_id",
        "fields": [
          { "column": "guest_name", "label": "Your name", "type": "text", "required": true, "max_length": 80 },
          { "column": "guest_count", "label": "How many are coming (including you)?", "type": "number", "required": true, "min": 1, "max": 20 },
          { "column": "status", "label": "Will you attend?", "type": "select", "required": true, "values": ["going", "maybe"] }
        ],
        "fixed_values": { "source": "external" },
        "max_submissions": 200,
        "event": "event.rsvp_submitted"
      }
    }
  },
  "publishes": ["event.created", "event.cancelled"],
  "alert_on": ["event.created", "event.rsvp_submitted"],
  "nav": { "label": "RSVPs" },
  "agenda": {
    "kind": "event",
    "label": "Event",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, NULLIF(location, '') AS subtitle, event_date AS when_at FROM app_event_rsvps__events WHERE substr(event_date, 1, 10) = :today AND cancelled = 0 LIMIT 20"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, NULLIF(location, '') AS subtitle, event_date AS at FROM app_event_rsvps__events WHERE cancelled = 0 AND substr(event_date, 1, 10) >= :today ORDER BY event_date LIMIT 3"
    },
    "display": { "template": "list", "title": "title", "subtitle": "subtitle", "when": "at" }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🎟️",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["upcoming_events", "event_rsvp_summary"]
  }
}
